# ==============================================================================
# Common GCP Host Infrastructure Configuration (Shared Template)
# Copy this file to terraform_common.tfvars and fill in your project ID.
# ==============================================================================

# Required: Set your Google Cloud Project ID
project_id = "your-gcp-project-id"

# ------------------------------------------------------------------------------
# OPTION 1: 100% Always Free Tier (US Region) — [DEFAULT]
# ------------------------------------------------------------------------------
region            = "us-central1"
zone              = "us-central1-a"
instance_name     = "nse-trading-terminal"
machine_type      = "e2-micro"
boot_disk_size_gb = 30
boot_disk_type    = "pd-standard"

# ------------------------------------------------------------------------------
# OPTION 2: Low-Latency India Region (Mumbai) — (~₹650 INR/month)
# To switch to Mumbai, comment out Option 1 and uncomment below:
# ------------------------------------------------------------------------------
# region            = "asia-south1"
# zone              = "asia-south1-a"
# instance_name     = "nse-trading-terminal"
# machine_type      = "e2-micro"
# boot_disk_size_gb = 10
# boot_disk_type    = "pd-standard"

# Network Firewall Ingress
allowed_ingress_cidrs = ["0.0.0.0/0"]

# ------------------------------------------------------------------------------
# OPTION 3: Automated Market Hours Schedule (Auto Start & Stop VM)
# Set enable_schedule = true to automatically start VM at 09:00 AM IST
# and stop it at 03:45 PM IST (Monday - Friday).
# ------------------------------------------------------------------------------
enable_schedule   = false
schedule_timezone = "Asia/Kolkata"
schedule_start    = "00 09 * * 1-5"   # 09:00 AM IST Mon-Fri
schedule_stop     = "45 15 * * 1-5"   # 03:45 PM IST Mon-Fri

