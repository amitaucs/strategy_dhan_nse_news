# Application Environment Configuration
APP_ENV=development
LOG_LEVEL=INFO

# NSE Poller Configuration
NSE_POLL_INTERVAL_SECONDS=60
NSE_BASE_URL=https://www.nseindia.com
NSE_ANNOUNCEMENTS_API=https://www.nseindia.com/api/corporate-announcements?index=equities

# API / Broker Credentials
DHAN_CLIENT_ID=
DHAN_ACCESS_TOKEN=
DHAN_APP_ID=
DHAN_APP_SECRET=
DHAN_REDIRECT_URL=https://stnse.amitdatta.co.in/api/auth/dhan/callback

# AI Reasoning & Conviction Gate
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_THINKING_BUDGET=0
CONFIDENCE_THRESHOLD=70

# MySQL durable persistence (Optional - falls back to SQLite)
MYSQL_HOST=
MYSQL_PORT=3306
MYSQL_DATABASE=
MYSQL_USER=
MYSQL_PASSWORD=

# Execution & Risk Controls
DRY_RUN=true
AUTO_ORDER=true
CAPITAL_PER_TRADE=20000.0
MAX_SHARES_PER_TRADE=10
MAX_ORDERS_PER_DAY=3

# Super Order / Bracket Risk Management
SUPER_ORDER_ENABLED=true
TARGET_PROFIT_PCT=3.0
STOP_LOSS_PCT=1.0
TRAILING_JUMP_POINTS=5.0
SLIPPAGE_BUFFER_PCT=0.2

# Intraday Timing & Auto Square-Off Controls (IST)
TRADE_CUTOFF_TIME=14:45
SQUARE_OFF_TIME=15:00

# Simulation controls for GUI
IS_SIMULATE_FEED=false
