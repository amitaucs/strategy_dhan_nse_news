# Application Environment & Server
APP_ENV=development
LOG_LEVEL=INFO
HOST=0.0.0.0
PORT=8015

# Dhan API / Broker Credentials
DHAN_CLIENT_ID=your_dhan_client_id
DHAN_ACCESS_TOKEN=your_dhan_access_token
DHAN_APP_ID=your_dhan_app_id
DHAN_APP_SECRET=your_dhan_app_secret
DHAN_REDIRECT_URL=http://localhost:8015/api/auth/dhan/callback
DHAN_AUTH_URL=https://auth.dhan.co

# Strategy Indicator Parameters
UNIVERSE_TYPE=NIFTY_200
EMA_FAST=20
EMA_MID=50
EMA_SLOW=200
EMA_PROXIMITY_PCT=0.5
SUPERTREND_PERIOD=10
SUPERTREND_MULTIPLIER=3.0
RISK_REWARD_RATIO=3.0
SWING_LOW_LOOKBACK=10
HISTORY_DAYS=60

# Position Sizing & Execution Controls
CAPITAL_PER_POSITION=50000.0
MAX_POSITIONS=5
PRODUCT_TYPE=CNC
ORDER_TYPE=FOREVER_OCO
DRY_RUN=true
AUTO_ORDER=false
SCAN_INTERVAL_MINUTES=15

# Database Persistence
DATABASE_PATH=data/st15.db
