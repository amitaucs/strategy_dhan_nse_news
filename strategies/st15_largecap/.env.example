# ==============================================================================
# Environment Configuration for ST15_LargeCap Positional Momentum Strategy
# ==============================================================================

APP_ENV=development
LOG_LEVEL=INFO
PORT=8015

# Dhan Broker API Credentials
DHAN_CLIENT_ID=
DHAN_ACCESS_TOKEN=
DHAN_APP_ID=
DHAN_APP_SECRET=
DHAN_REDIRECT_URL=http://localhost:8015/api/auth/dhan/callback
DHAN_AUTH_URL=https://auth.dhan.co

# Strategy Technical Parameters
UNIVERSE_TYPE=NIFTY_200
EMA_PROXIMITY_PCT=0.5          # Tolerance buffer for EMA kiss/touch (0.5%)
SUPERTREND_PERIOD=10           # SuperTrend ATR lookback period
SUPERTREND_MULTIPLIER=3.0      # SuperTrend volatility multiplier
RISK_REWARD_RATIO=3.0          # Target profit multiplier (e.g. 1:3 R:R)
SWING_LOW_LOOKBACK=10          # 2H candles to scan for swing low SL
SCAN_INTERVAL_MINUTES=15       # Polling interval during market hours

# Position Sizing & Execution Controls
CAPITAL_PER_POSITION=50000.0   # Allocated capital per stock (INR)
MAX_POSITIONS=5                # Maximum simultaneous open positions
PRODUCT_TYPE=CNC               # CNC (Cash Delivery) or MTF (Margin Trading)

# Execution Flags
DRY_RUN=true                   # Set to false for live Dhan orders
AUTO_ORDER=false               # Auto-place orders when setup completes
